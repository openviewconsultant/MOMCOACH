# URL pública del sitio (sin barra final). Se usa para construir las URLs de
# retorno y de notificación (webhook) que se envían a Mercado Pago.
# En producción debe ser https:// (Mercado Pago lo exige para auto_return).
NEXT_PUBLIC_SITE_URL=https://www.themomcoaching.com

# Access Token de producción de tu cuenta de Mercado Pago (Tus integraciones
# > tu app > Credenciales de producción). NUNCA lo publiques ni lo subas a git.
MERCADOPAGO_ACCESS_TOKEN=

# Clave secreta para verificar la firma del webhook (Tus integraciones > tu
# app > Webhooks > Configurar notificaciones). Opcional pero muy recomendado.
MERCADOPAGO_WEBHOOK_SECRET=

# Proyecto de Supabase "momcoach" (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://vkqbgzuzawxzijktffgx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (secreta, NUNCA exponerla al navegador). Solo se usa en
# rutas de servidor (crear-preferencia, webhook, descarga gratuita).
SUPABASE_SERVICE_ROLE_KEY=

# Cuenta de Gmail usada para enviar el correo con los enlaces de descarga
# tras un pago aprobado. GMAIL_USER es la dirección completa (ej.
# pedidos@gmail.com). GMAIL_APP_PASSWORD es una "Contraseña de aplicación"
# generada en https://myaccount.google.com/apppasswords (requiere tener
# activada la verificación en 2 pasos en esa cuenta). NUNCA subas esta
# contraseña a git.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Nombre que aparece como remitente junto al correo, ej. "The Mom Coach".
GMAIL_FROM_NAME=The Mom Coach

# Acceso a Google Calendar (consultar disponibilidad y crear eventos de
# citas, reemplaza a Cal.com). Las cuentas de servicio NO pueden escribir
# eventos en calendarios de Gmail personales, así que se usa OAuth2 con
# autorización de la persona dueña del calendario:
#   1. Google Cloud Console > APIs & Services > Credentials > Create
#      Credentials > OAuth client ID > "Web application", con
#      http://localhost:3939/oauth2callback como Authorized redirect URI.
#   2. Copia el Client ID y Client Secret aquí abajo.
#   3. Corre `node scripts/google-oauth-setup.mjs` y sigue las instrucciones
#      para obtener GOOGLE_OAUTH_REFRESH_TOKEN.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# ID del calendario a usar (normalmente el correo de Gmail del calendario).
GOOGLE_CALENDAR_ID=

# Configuración de disponibilidad de citas (todas opcionales, tienen
# valores por defecto razonables). El horario real disponible siempre se
# calcula cruzando esta ventana con lo que ya está ocupado en el Google
# Calendar real, así que basta con bloquear tiempo en el calendario para
# quitar disponibilidad.
# BOOKING_TIMEZONE=America/Bogota
# BOOKING_SLOT_MINUTES=30
# BOOKING_DAY_START_HOUR=8
# BOOKING_DAY_END_HOUR=19
# BOOKING_WORKING_DAYS=1,2,3,4,5,6
# BOOKING_ADVANCE_DAYS=21
# BOOKING_MIN_NOTICE_HOURS=12
