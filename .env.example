# URL pública del sitio (sin barra final). Se usa para construir las URLs de
# retorno y de notificación (webhook) que se envían a Mercado Pago.
# En producción debe ser https:// (Mercado Pago lo exige para auto_return).
NEXT_PUBLIC_SITE_URL=https://www.themomcoaching.com

# Access Token de producción de tu cuenta de Mercado Pago (Tus integraciones
# > tu app > Credenciales de producción). NUNCA lo publiques ni lo subas a git.
MERCADOPAGO_ACCESS_TOKEN=

# Clave secreta para verificar la firma del webhook (Tus integraciones > tu
# app > Webhooks > Configurar notificaciones). Opcional pero muy recomendado.
MERCADOPAGO_WEBHOOK_SECRET=

# Proyecto de Supabase "momcoach" (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://vkqbgzuzawxzijktffgx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (secreta, NUNCA exponerla al navegador). Solo se usa en
# rutas de servidor (crear-preferencia, webhook, descarga gratuita).
SUPABASE_SERVICE_ROLE_KEY=

# Cuenta de Resend (resend.com) usada para enviar el correo con los enlaces
# de descarga tras un pago aprobado.
RESEND_API_KEY=
RESEND_FROM_EMAIL=The Mom Coach <ventas@themomcoaching.com>
